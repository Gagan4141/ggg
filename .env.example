# Maximum upload size in megabytes. Uploaded files are processed in memory only.
MAX_UPLOAD_MB=15
# OCR backend: auto (uses OpenAI when OPENAI_API_KEY is configured) or none
OCR_PROVIDER=auto
# OpenAI API key. Store the real secret only in Vercel Environment Variables.
OPENAI_API_KEY=your_api_key_here
# Optional model override. Default: gpt-4.1-mini
OPENAI_MODEL=gpt-4.1-mini
